<li class="social-item"><span class="social-badge social-whatsapp"><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" style="fill:none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M20.5 11.6a8.6 8.6 0 0 1-12.7 7.6L3 20.5l1.3-4.7a8.6 8.6 0 1 1 16.2-4.2Z"/><path d="m8.4 7.2 1.5 2.7-1 1.2c.8 1.7 2 2.9 3.8 3.6l1.1-1.2 2.7 1.4c-.3 2.6-2.5 2.2-4.3 1.4-2.9-1.3-5.3-3.9-5.6-6.5-.1-1.2.5-2.3 1.8-2.6Z"/></svg></span><span>WhatsApp</span></li>
</ul></div></section></main><footer><div class="wrap site-credit"><a href="https://quantix.software" target="_blank" rel="noopener noreferrer">Sitio creado por <strong>quantix.software</strong></a></div></footer><script>
function syncTitle(){
  const root=document.documentElement;
  const title=document.querySelector('.fixed-name');
  const isScrolled=scrollY>40;
  root.classList.toggle('scrolled',isScrolled);
  title?.classList.toggle('is-scrolled',isScrolled);
}
const siteIcon=document.createElement('link');siteIcon.rel='icon';siteIcon.type='image/png';siteIcon.href='/kivo-favicon.png?v=20261123';document.head.append(siteIcon);
const touchIcon=document.createElement('link');touchIcon.rel='apple-touch-icon';touchIcon.href='/kivo-favicon.png?v=20261123';document.head.append(touchIcon);
syncTitle();window.addEventListener('scroll',syncTitle,{passive:true});window.addEventListener('pageshow',syncTitle);
document.querySelector('.maplink')?.setAttribute('href','https://maps.app.goo.gl/2nkLaP2NGRNkeiRW9');
const headerStatus=document.createElement('span');headerStatus.id='header-estado';headerStatus.setAttribute('role','status');document.querySelector('.fixed-name')?.append(headerStatus);



const plates=[...document.querySelectorAll('.plates .presentation')];let active=0,timer;
function advance(){plates[active].classList.remove('on');active=(active+1)%plates.length;plates[active].classList.add('on')}
const reducedMotion=matchMedia('(prefers-reduced-motion: reduce)');
function syncRotation(){clearInterval(timer);if(!reducedMotion.matches&&!document.hidden)timer=setInterval(advance,4500)}
reducedMotion.addEventListener('change',syncRotation);document.addEventListener('visibilitychange',syncRotation);syncRotation();
const fotos=[['fachada','Una noche en Nindirí'],['enchilada','La enchilada'],['cacao','Cacao con hielo'],['nachos','Nachos para compartir'],['tacos-mesa','Tacos a la mesa']];let current=0;
function showPhoto(i){current=(i+fotos.length)%fotos.length;const [file,label]=fotos[current];large.src='img/'+file+'.webp';if(!reducedMotion.matches)large.animate([{opacity:.35},{opacity:1}],{duration:320});large.alt=caption.textContent=label}
fotos.forEach(([file,label],i)=>{const b=document.createElement('button');b.innerHTML='<img loading="lazy" alt="" src="img/'+file+'.webp"><span>'+label+'</span>';b.onclick=()=>{showPhoto(i);viewer.showModal()};document.querySelector('.photos').append(b)});
const tiktokItem=document.querySelector('.social-tiktok')?.closest('.social-item');
if(tiktokItem){const tiktokLink=document.createElement('a');tiktokLink.className='social-link';tiktokLink.href='https://www.tiktok.com/@sazonsheyla?is_from_webapp=1&sender_device=pc';tiktokLink.target='_blank';tiktokLink.rel='noopener noreferrer';while(tiktokItem.firstChild)tiktokLink.append(tiktokItem.firstChild);tiktokItem.append(tiktokLink)}
const whatsappItem=document.querySelector('.social-whatsapp')?.closest('.social-item');
if(whatsappItem){const whatsappLink=document.createElement('a');whatsappLink.className='social-link';whatsappLink.href='https://wa.me/50577765119';whatsappLink.target='_blank';whatsappLink.rel='noopener noreferrer';while(whatsappItem.firstChild)whatsappLink.append(whatsappItem.firstChild);whatsappItem.append(whatsappLink)}
cerrar.onclick=()=>viewer.close();prevPhoto.onclick=()=>showPhoto(current-1);nextPhoto.onclick=()=>showPhoto(current+1);viewer.onkeydown=e=>{if(e.key==='ArrowRight')showPhoto(current+1);if(e.key==='ArrowLeft')showPhoto(current-1)};


const sectionMotion = new WeakMap();
if ('IntersectionObserver' in window) {
  const observer = new IntersectionObserver(entries => {
    for (const entry of entries) {
      if (!entry.isIntersecting || reducedMotion.matches) continue;
      const element = entry.target;
      const fromBelow = entry.boundingClientRect.top > innerHeight / 2;
      sectionMotion.get(element)?.cancel();
      sectionMotion.set(element, element.animate([
        { opacity: .45, transform: 'translateY(' + (fromBelow ? 22 : -22) + 'px)' },
        { opacity: 1, transform: 'translateY(0)' }
      ], { duration: 520, easing: 'cubic-bezier(.2,.7,.2,1)' }));
    }
  }, { threshold: .12 });
  document.querySelectorAll('.intro .art,.arrival h2,.maplink,.hours,.story>div,.kitchen>*,.albumtop,.photos button,.location .wrap,footer .wrap').forEach(element => observer.observe(element));
}
document.addEventListener('click', event => {
  const control = event.target.closest('a,button,summary');
  if (!control || reducedMotion.matches || event.ctrlKey || event.metaKey || event.altKey || event.shiftKey) return;
  control.animate([{scale:'.96'},{scale:'1.025',offset:.55},{scale:'1'}],{duration:240,easing:'ease-out'});
  if (control.matches('a.delivery') && !event.defaultPrevented) {
    event.preventDefault();
    setTimeout(() => location.assign(control.href), 220);
  }
});
const localClock=new Intl.DateTimeFormat('en-US',{timeZone:'America/Managua',weekday:'short',hour:'2-digit',hourCycle:'h23'});
function statusAt(now){
  const parts=Object.fromEntries(localClock.formatToParts(now).map(part=>[part.type,part.value]));
  const hour=Number(parts.hour);
  const closeHour=['Fri','Sat','Sun'].includes(parts.weekday)?23:22;
  if(hour<10)return 'Cerrado · Abre a las 10 a. m.';
  if(hour>=closeHour)return 'Cerrado · Abre mañana a las 10 a. m.';
  return 'Abierto · Hasta las '+(closeHour-12)+' p. m.';
}
function updateStatus(){const badge=document.getElementById('estado');const value=statusAt(new Date());if(badge.textContent!==value)badge.textContent=value;badge.dataset.open=String(value.startsWith('Abierto'));headerStatus.textContent=value;headerStatus.dataset.open=String(value.startsWith('Abierto'))}
updateStatus();setInterval(updateStatus,15000);document.addEventListener('visibilitychange',updateStatus);
const orderButton=document.querySelector('a.delivery');
if('IntersectionObserver' in window){
  let buttonVisible=false;
  function syncInvitation(){orderButton.classList.toggle('invite',buttonVisible&&!document.hidden)}
  const invite=new IntersectionObserver(([entry])=>{
    buttonVisible=entry.isIntersecting;
    syncInvitation();
  });
  document.addEventListener('visibilitychange',syncInvitation);
  invite.observe(orderButton);
}

const socialSection=document.querySelector('.social-section');
if('IntersectionObserver' in window){
  let socialVisible=false;
  const syncSocial=()=>socialSection.classList.toggle('is-visible',socialVisible&&!document.hidden);
  new IntersectionObserver(([entry])=>{socialVisible=entry.isIntersecting;syncSocial()},{threshold:.15}).observe(socialSection);
  document.addEventListener('visibilitychange',syncSocial);
}

// Discover every managed image generated into public/img at build time.
const manifestGallery=document.querySelector('.plates');
const manifestPhotos=document.querySelector('.photos');
let manifestSlides=[];
let manifestGalleryIndex=0;
let manifestTimer;
let dynamicPhotos=[];
function manifestAdvance(){
  if(manifestSlides.length<2)return;
  manifestSlides[manifestGalleryIndex]?.classList.remove('on');
  manifestGalleryIndex=(manifestGalleryIndex+1)%manifestSlides.length;
  manifestSlides[manifestGalleryIndex]?.classList.add('on');
}
function syncManifestRotation(){
  clearInterval(manifestTimer);
  if(manifestSlides.length>1&&!reducedMotion.matches&&!document.hidden)manifestTimer=setInterval(manifestAdvance,4500);
}
function renderManifestGallery(images){
  if(!Array.isArray(images)||!images.length)return;
  clearInterval(timer);
  const heroImages=images.filter((image)=>!['fachada.webp','enchilada.webp','nachos.webp','tacos.webp'].includes(image.name.toLowerCase()));
  const slidesSource=heroImages.length?heroImages:images;
  manifestSlides=slidesSource.map((image,index)=>{
    const slide=document.createElement('div');
    slide.className='presentation'+(index===0?' on':'')+(image.name.toLowerCase()==='cacao.webp'?' drink':'');
    slide.style.position='absolute';slide.style.inset='0';
    const photo=document.createElement('img');
    photo.className='product';photo.loading=index===0?'eager':'lazy';photo.alt=image.label;photo.src=image.src;
    photo.style.position='absolute';photo.style.inset='0';photo.style.width='100%';photo.style.height='100%';photo.style.objectFit='contain';
    slide.append(photo);return slide;
  });
  manifestGallery.replaceChildren(...manifestSlides);manifestGalleryIndex=0;syncManifestRotation();
  dynamicPhotos=images;
  manifestPhotos.replaceChildren();
  dynamicPhotos.forEach((image,index)=>{
    const button=document.createElement('button');
    button.innerHTML=`<img loading="lazy" alt="" src="${image.src}"><span>${image.label}</span>`;
    button.onclick=()=>{showManifestPhoto(index);viewer.showModal()};
    manifestPhotos.append(button);
  });
}
function showManifestPhoto(index){
  if(!dynamicPhotos.length)return;
  const item=dynamicPhotos[(index+dynamicPhotos.length)%dynamicPhotos.length];
  current=(index+dynamicPhotos.length)%dynamicPhotos.length;
  large.src=item.src;large.alt=caption.textContent=item.label;
}
async function loadImageManifest(){
  try{
    const response=await fetch('/img-manifest.json',{cache:'no-store'});
    if(!response.ok)throw new Error('manifest unavailable');
    const images=await response.json();
    if(!images.length)return;
    renderManifestGallery(images);
    prevPhoto.onclick=()=>showManifestPhoto(current-1);
    nextPhoto.onclick=()=>showManifestPhoto(current+1);
  }catch(error){console.warn('Using bundled image carousel fallback',error)}
}
reducedMotion.addEventListener('change',syncManifestRotation);
document.addEventListener('visibilitychange',syncManifestRotation);
loadImageManifest();
</script></html>

