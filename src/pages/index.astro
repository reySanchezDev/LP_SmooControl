---
import '../styles/global.css';

const products = [
  { name: 'Tacos para comer aquí', description: 'Sabor casero, tortillas recién hechas y ese toque que nos distingue.', image: '/assets/fotografias/Tacos_Para_Comer_Aqui_Transparente.png' },
  { name: 'Tacos para llevar', description: 'Toda la sazón de Sheyla, lista para compartir donde estés.', image: '/assets/fotografias/Tacos_Para_Llevar_Transparente.png' },
  { name: 'Nachos para comer aquí', description: 'Crujientes, abundantes y perfectos para disfrutar en familia.', image: '/assets/fotografias/Nachos_Para_Comer_Aqui_Transparente.png' },
  { name: 'Enchilada para comer aquí', description: 'Una receta reconfortante con el sabor tradicional de nuestra cocina.', image: '/assets/fotografias/Enchilada_Para_Comer_Aqui_Transparente.png' },
  { name: 'Refresco de cacao', description: 'Fresco, cremoso y servido con cubitos para acompañar tu comida.', image: '/assets/fotografias/Refresco_de_Cacao_Con_Cubitos_Transparente.png' },
];
const gallery = [
  '/assets/fotografias/Portada_Google_Maps_Restaurada_2160x1216.jpg',
  '/assets/fotografias/Tacos_Para_Comer_Aqui_Fondo_Blanco.jpg',
  '/assets/fotografias/Nachos_Para_Comer_Aqui_Fondo_Blanco.jpg',
  '/assets/fotografias/Enchilada_Para_Comer_Aqui_Fondo_Blanco.jpg',
];
---
<!doctype html>
<html lang="es-NI">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="La Sazón de Sheyla, un rincón familiar de Nindirí con sabor casero." />
    <link rel="icon" type="image/png" href="/assets/originales/logo.png" />
    <title>La Sazón de Sheyla | Sabor casero en Nindirí</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="#inicio" aria-label="La Sazón de Sheyla, inicio"><img src="/assets/originales/logo.png" alt="La Sazón de Sheyla" /></a>
      <nav class="desktop-nav" aria-label="Navegación principal"><a href="#historia">Nuestra historia</a><a href="#cocina">Nuestra cocina</a><a href="#galeria">Galería</a><a href="#contacto">Visítanos</a></nav>
      <a class="nav-cta" href="https://sazoncheyla.com" target="_blank" rel="noreferrer">Pedí a domicilio <span aria-hidden="true">↗</span></a>
    </header>
    <main>
      <section id="inicio" class="hero section-culinary">
        <div class="hero-copy"><p class="eyebrow">Un rincón familiar de Nindirí</p><h1>El sabor que se queda<br /><em>en el corazón.</em></h1><p class="hero-text">Cocina honesta, recetas con historia y momentos para compartir alrededor de una mesa.</p><div class="hero-actions"><a class="button button-primary" href="#cocina">Conocé nuestro menú <span aria-hidden="true">↓</span></a><a class="button button-ghost" href="#historia">Nuestra historia</a></div></div>
        <div class="hero-image-wrap"><div class="hero-image-frame"><img src="/assets/fotografias/Portada_Google_Maps_Restaurada_2160x1216.jpg" alt="Un plato servido en La Sazón de Sheyla" /></div><div class="hero-stamp" aria-hidden="true"><span>Hecho</span><strong>con</strong><span>amor</span></div></div>
        <a class="scroll-cue" href="#historia" aria-label="Desplazarse a nuestra historia"><span></span>Descubrí más</a>
      </section>
      <section id="historia" class="story section-culinary"><div class="section-intro"><p class="eyebrow">Nuestra historia</p><h2>Una mesa llena de<br /><em>recuerdos.</em></h2></div><div class="story-content"><p class="lead">En La Sazón de Sheyla creemos que la mejor comida es la que se comparte.</p><p>Nacimos con el deseo de servir ese sabor de casa que reúne a la familia: recetas sencillas, ingredientes frescos y mucho cariño en cada plato. Somos un lugar para llegar sin prisa, sentarse a la mesa y sentirse como en casa.</p><p>Desde Nindirí, celebramos lo nuestro con una cocina cercana, generosa y llena de tradición.</p><a class="text-link" href="#contacto">Conocé nuestro rincón <span aria-hidden="true">→</span></a></div></section>
      <section id="cocina" class="kitchen section-dark"><div class="section-heading centered"><p class="eyebrow">Nuestra cocina</p><h2>Hecho para<br /><em>disfrutar.</em></h2><p>Sabores que cuentan nuestra historia y se disfrutan mejor en buena compañía.</p></div><div class="product-grid">{products.map((product) => <article class="product-card"><div class="product-image"><img src={product.image} alt={product.name} loading="lazy" /></div><div class="product-copy"><h3>{product.name}</h3><p>{product.description}</p></div></article>)}</div><div class="delivery-callout"><div><p class="eyebrow">El sabor va hacia vos</p><h2>Pedí a domicilio.</h2></div><a class="button button-light pulse-on-view" href="https://sazoncheyla.com" target="_blank" rel="noreferrer">Ordená ahora <span aria-hidden="true">↗</span></a></div></section>
      <section id="galeria" class="gallery-section section-cream"><div class="section-heading split-heading"><div><p class="eyebrow">Momentos para recordar</p><h2>Galería</h2></div><p>Un pedacito de nuestra mesa, nuestro barrio y la alegría de compartir.</p></div><div class="gallery-grid">{gallery.map((image, index) => <img class:list={[`gallery-image gallery-${index + 1}`]} src={image} alt="Momento de La Sazón de Sheyla" loading="lazy" />)}</div></section>
      <section id="contacto" class="social-section section-dark"><div class="social-copy"><p class="eyebrow">Seguinos y compartí</p><h2>Sigue a<br /><em>La Sazón de Sheyla.</em></h2><p>Encontrá más de nuestros sabores, novedades y momentos en redes sociales.</p></div><div class="social-mark"><img src="/assets/originales/logo.png" alt="" /></div><div class="social-links" aria-label="Redes sociales"><div class="social-link"><span class="social-icon">◎</span><span>TikTok</span><small>Próximamente</small></div><div class="social-link"><span class="social-icon">f</span><span>Facebook</span><small>Próximamente</small></div><div class="social-link"><span class="social-icon">◌</span><span>WhatsApp</span><small>Próximamente</small></div></div></section>
      <section class="visit-section section-cream"><div><p class="eyebrow">Te esperamos</p><h2>Vení a compartir<br /><em>la mesa.</em></h2></div><div class="visit-details"><p><strong>Horario de atención</strong><br />Lunes a jueves · 10:00 a. m. – 10:00 p. m.<br />Viernes a domingo · 10:00 a. m. – 11:00 p. m.</p><p><strong>Nindirí, Nicaragua</strong><br />Un lugar para comer rico y sentirse en casa.</p></div></section>
    </main>
    <footer class="site-footer"><img src="/assets/originales/logo.png" alt="La Sazón de Sheyla" /><p>© 2026 La Sazón de Sheyla</p><p>Hecho con cariño por <a href="https://www.quantix.software" target="_blank" rel="noreferrer">Quantix Software</a></p></footer>
    <script>
      const pulse = document.querySelector('.pulse-on-view');
      if (pulse && 'IntersectionObserver' in window) { const observer = new IntersectionObserver(([entry]) => pulse.classList.toggle('is-visible', entry.isIntersecting), { threshold: 0.2 }); observer.observe(pulse); }
    </script>
  </body>
</html>
