html,body{width:100%;min-width:0;overflow-x:hidden}
header.fixed-name::before{background:none!important;opacity:0!important}
header.fixed-name{width:100vw!important;height:158px!important}
.title-space{height:158px!important}
.intro.wrap{width:100%!important;max-width:none!important;margin-inline:0!important;padding-inline:16px!important}
.intro.wrap::before{width:100vw!important;left:50%!important;right:auto!important;transform:translateX(-50%)!important}
header.fixed-name.is-scrolled,html.scrolled header.fixed-name{height:58px!important}
@media (max-width:720px){header.fixed-name{height:100px!important}.title-space{height:100px!important}.intro.wrap{padding-inline:16px!important}header.fixed-name.is-scrolled,html.scrolled header.fixed-name{height:54px!important}}
@media (max-width:380px){header.fixed-name{height:90px!important}.title-space{height:90px!important}}
</style>
<style is:global>
/* Keep the header stable: the layout must not jump when scrolling. */
header.fixed-name,
header.fixed-name.is-scrolled,
html.scrolled header.fixed-name{
  height:64px!important;
  min-height:64px!important;
  box-sizing:border-box!important;
  padding:6px 16px!important;
  display:flex!important;
  align-items:center!important;
  justify-content:space-between!important;
}
.title-space{height:80px!important}
html{scroll-padding-top:80px!important}
header.fixed-name h1,
header.fixed-name.is-scrolled h1,
html.scrolled header.fixed-name h1{
  flex:1 1 auto;
  min-width:0;
  margin:0!important;
  text-align:left!important;
  font-size:clamp(25px,4vw,32px)!important;
  line-height:.82!important;
  white-space:normal!important;
}
header.fixed-name br,
header.fixed-name.is-scrolled br,
html.scrolled header.fixed-name br{display:inline!important}
header.fixed-name.is-scrolled,
html.scrolled header.fixed-name{
  background-color:rgba(250,243,223,.58)!important;
  -webkit-backdrop-filter:blur(10px) saturate(1.08)!important;
  backdrop-filter:blur(10px) saturate(1.08)!important;
}
@media(max-width:720px){
  header.fixed-name,
  header.fixed-name.is-scrolled,
  html.scrolled header.fixed-name{
    height:64px!important;
    min-height:64px!important;
    padding:6px 12px!important;
  }
  .title-space{height:80px!important}
  header.fixed-name h1,
  header.fixed-name.is-scrolled h1,
  html.scrolled header.fixed-name h1{font-size:clamp(24px,7vw,29px)!important;line-height:.82!important}
  #header-estado{font-size:clamp(12px,3.2vw,15px)!important}
}
@media(max-width:380px){
  header.fixed-name h1,
  header.fixed-name.is-scrolled h1,
  html.scrolled header.fixed-name h1{font-size:24px!important}
  #header-estado{font-size:11px!important}
}
</style>
<style is:global>
/* The section starts immediately after the fixed header; its content gets the breathing room. */
.title-space{height:64px!important}
.intro.wrap{padding-top:18px!important}
@media(min-width:721px){.intro.wrap{padding-top:24px!important}}
</style>
<style is:global>
header.fixed-name h1 i,
header.fixed-name.is-scrolled h1 i,
html.scrolled header.fixed-name h1 i{
  display:block!important;
  margin-left:1.05em!important;
}
#header-estado{font-weight:700!important}
</style>
<style is:global>
.intro .product-tag{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  gap:12px;
  width:fit-content;
  max-width:100%;
  min-height:44px;
  margin-inline:auto;
  padding:8px 21px;
  border:1px solid #c5aa76;
  border-radius:40px;
  background:#234437;
  color:#fff5dc;
  box-shadow:0 4px 14px #17271e42,inset 0 0 0 3px #234437,inset 0 0 0 4px #c5aa76;
  font:500 italic 22px/1.2 var(--font-display);
}
.product-tag svg{flex:0 0 auto;width:12px;height:12px;color:#d7b77b}
.product-tag #product-name{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
</style>
<style is:global>
.header-message,.header-message *{box-sizing:border-box}
.header-message{
  position:absolute;
  top:100%;
  inset-inline:0;
  display:grid;
  align-items:center;
  min-height:44px;
  padding:10px 16px;
  border-block:1px solid #c5aa76;
  background:#234437;
  color:#fff5dc;
  font:600 15px/1.55 var(--font-body);
  text-align:center;
  pointer-events:auto;
}
.header-message[hidden]{display:none}
.header-message-viewport{min-width:0;overflow:hidden}
.header-message-text{display:inline-block}
html.has-header-message .title-space{height:calc(64px + var(--header-message-height,0px))!important}
html.has-header-message{scroll-padding-top:calc(80px + var(--header-message-height,0px))!important}
@media(min-width:721px){
  html.has-header-message header.fixed-name{
    display:grid!important;
    grid-template-columns:max-content minmax(0,1fr) max-content;
  }
  html.has-header-message header.fixed-name h1{grid-column:1;grid-row:1}
  html.has-header-message #header-estado{grid-column:3;grid-row:1}
  .header-message{
    position:static;
    grid-column:2;
    grid-row:1;
    min-width:0;
    min-height:0;
    padding:0;
    border:0;
    background:none;
    color:#43291e;
    line-height:1.3;
  }
}
@media(max-width:720px){
  .header-message{min-height:64px;padding:14px 16px}
  .header-message-text{width:max-content;white-space:nowrap}
  .header-message.has-overflow .header-message-viewport{overflow-x:auto;scrollbar-width:none;text-align:left}
  .header-message-viewport::-webkit-scrollbar{display:none}
  @media(prefers-reduced-motion:no-preference){
    .header-message.has-overflow .header-message-text{animation:header-message-pan var(--message-duration,20s) linear infinite alternate}
    .header-message-viewport:is(:hover,:focus-visible) .header-message-text{animation-play-state:paused}
    @keyframes header-message-pan{
      0%,12%{transform:translateX(0)}
      88%,100%{transform:translateX(var(--message-travel,0px))}
    }
  }
}
</style>
<style is:global>
/* Desktop distribution follows the current hensell.dev layout tokens. */
:root{
  --hensell-shell-max:1220px;
  --hensell-content-max:1080px;
  --hensell-reading-max:720px;
  --hensell-panel-max:680px;
  --hensell-showcase-max:860px;
  --hensell-gutter:clamp(14px,3.5vw,56px);
}

.kitchen-heading,.kitchen-copy{display:contents}
.kitchen-copy>p:first-child{margin-top:1em}

@media (min-width:721px){
  .wrap{
    width:min(var(--hensell-content-max),calc(100% - (2 * var(--hensell-gutter))))!important;
    max-width:var(--hensell-content-max)!important;
    margin-inline:auto!important;
  }

  .intro.wrap,
  .story.wrap,
  .kitchen.wrap{
    width:min(var(--hensell-shell-max),calc(100% - (2 * var(--hensell-gutter))))!important;
    max-width:var(--hensell-shell-max)!important;
    margin-inline:auto!important;
  }

  .location,
  .album,
  .social-section{
    width:min(var(--hensell-shell-max),calc(100% - (2 * var(--hensell-gutter))))!important;
    max-width:var(--hensell-shell-max)!important;
    margin-inline:auto!important;
  }

  .location .wrap,
  .album .wrap,
  .social-section .wrap{
    width:min(var(--hensell-content-max),100%)!important;
    max-width:var(--hensell-content-max)!important;
  }

  .intro::before,
  #historia::before,
  .kitchen::before{
    inset:0!important;
  }

  .intro.wrap::before{
    width:auto!important;
    left:0!important;
    right:0!important;
    transform:none!important;
  }

  .intro .art{
    width:min(100%,340px)!important;
    margin-inline:auto!important;
  }

  .story,
  .kitchen{
    /* Percent padding uses the containing block, not this capped section.
       Subtract the shell gutters and cap the inset at (1220 - 1080) / 2. */
    padding-inline:clamp(0px,calc((100% - (2 * var(--hensell-gutter)) - var(--hensell-content-max)) / 2),calc((var(--hensell-shell-max) - var(--hensell-content-max)) / 2))!important;
  }

  .story,
  .kitchen>div{
    grid-template-columns:minmax(0,1fr) minmax(0,1.1fr)!important;
    column-gap:8%!important;
    align-items:start!important;
  }

  .kitchen>div{
    max-width:none!important;
    width:100%;
    display:grid!important;
  }

  .story>div,
  .kitchen>div>div{
    min-width:0;
  }

  .kitchen-heading,.kitchen-copy{display:block}
  .kitchen-copy>p:first-child{margin-top:0}

  .story p,
  .kitchen p{
    max-width:100%;
  }

  @media (max-width:1000px){
    .kitchen>div{grid-template-columns:minmax(0,1fr)!important;gap:24px!important}
  }

  header.fixed-name{
    width:min(var(--hensell-shell-max),calc(100% - (2 * var(--hensell-gutter))))!important;
    left:50%!important;
    right:auto!important;
    transform:translateX(-50%) translateZ(0)!important;
  }
}

@media (max-width:720px){
  .wrap{width:calc(100% - 32px)!important;max-width:none!important}
  .intro.wrap{width:100%!important;max-width:none!important}
}

@media (min-width:721px){
  /* Extend only the section backgrounds while preserving their centering. */
  .location,
  .album{
    width:calc(min(var(--hensell-shell-max),calc(100% - (2 * var(--hensell-gutter)))) + 2px)!important;
    max-width:calc(var(--hensell-shell-max) + 2px)!important;
    margin-inline:auto!important;
  }
}

</style>

<style is:global>
  /* Keep the editable brand artwork visible as a quiet wallpaper behind all sections. */
  body {
    isolation: isolate;
    position: relative;
  }

  body::before {
    content: "";
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: url('/Fondo.svg') center / cover no-repeat;
    opacity: 1;
    --wallpaper-gutter: max(0px, calc((100% - min(1220px, 89%)) / 2));
    -webkit-mask-image: linear-gradient(
      to right,
      #000 0,
      #000 var(--wallpaper-gutter),
      transparent var(--wallpaper-gutter),
      transparent calc(100% - var(--wallpaper-gutter)),
      #000 calc(100% - var(--wallpaper-gutter)),
      #000 100%
    );
    mask-image: linear-gradient(
      to right,
      #000 0,
      #000 var(--wallpaper-gutter),
      transparent var(--wallpaper-gutter),
      transparent calc(100% - var(--wallpaper-gutter)),
      #000 calc(100% - var(--wallpaper-gutter)),
      #000 100%
    );
  }

  @media (max-width: 720px) {
    body::before {
      --wallpaper-gutter: 0px;
    }
  }

</style>
