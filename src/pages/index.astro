<style is:global>
/* Keep the header stable: the layout must not jump when scrolling. */
header.fixed-name,
header.fixed-name.is-scrolled,
html.scrolled header.fixed-name{
  height:64px!important;
  min-height:64px!important;
  box-sizing:border-box!important;
  padding:6px 16px!important;
  display:flex!important;
  align-items:center!important;
  justify-content:space-between!important;
}
.title-space{height:80px!important}
html{scroll-padding-top:80px!important}
header.fixed-name h1,
header.fixed-name.is-scrolled h1,
html.scrolled header.fixed-name h1{
  flex:1 1 auto;
  min-width:0;
  margin:0!important;
  text-align:left!important;
  font-size:clamp(25px,4vw,32px)!important;
  line-height:.82!important;
  white-space:normal!important;
}
header.fixed-name br,
header.fixed-name.is-scrolled br,
html.scrolled header.fixed-name br{display:inline!important}
header.fixed-name.is-scrolled,
html.scrolled header.fixed-name{
  background-color:rgba(250,243,223,.58)!important;
  -webkit-backdrop-filter:blur(10px) saturate(1.08)!important;
  backdrop-filter:blur(10px) saturate(1.08)!important;
}
@media(max-width:720px){
  header.fixed-name,
  header.fixed-name.is-scrolled,
